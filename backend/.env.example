# Server Configuration
PORT=5000
NODE_ENV=development

# Database Connection
MONGODB_URI=mongodb://127.0.0.1:27017/sports_turf_booking

# JWT Secret & Expiry
JWT_SECRET=your_super_secret_jwt_key_change_in_production
JWT_EXPIRES_IN=7d

# CORS Allowed Origins (Comma-separated for multiple origins, e.g. local + Vercel)
CLIENT_ORIGIN=http://localhost:5173,https://sports-turf-booking.vercel.app
